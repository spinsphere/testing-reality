[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/quagmire/bin/linux/libquagmire_godot.so"
linux.release.x86_64 = "res://addons/quagmire/bin/linux/libquagmire_godot.so"
windows.debug.x86_64 = "res://addons/quagmire/bin/windows/quagmire_godot.dll"
windows.release.x86_64 = "res://addons/quagmire/bin/windows/quagmire_godot.dll"
macos.debug = "res://addons/quagmire/bin/macos/libquagmire_godot.dylib"
macos.release = "res://addons/quagmire/bin/macos/libquagmire_godot.dylib"
# Web (single-threaded dlink templates; Godot 4.7 ships its threaded web template as wasm64,
# which Rust cannot target through Emscripten). Export preset "Web": Extensions Support on,
# Thread Support off.
web.debug.wasm32 = "res://addons/quagmire/bin/web/quagmire_godot.wasm"
web.release.wasm32 = "res://addons/quagmire/bin/web/quagmire_godot.wasm"
# Android: arm64-v8a only (export preset "Android"); built by sdk-godot/build.sh android.
android.debug.arm64 = "res://addons/quagmire/bin/android/libquagmire_godot.so"
android.release.arm64 = "res://addons/quagmire/bin/android/libquagmire_godot.so"
