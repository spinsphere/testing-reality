    "two_particle_list": "\\ket{\\H}_1\\ket{\\H}_2 \\quad\\text{reads}\\quad \\text{``photon 1 is}\\ \\H\\ \\text{and photon 2 is}\\ \\H\\text{''}",
    "product_expand": "\\begin{aligned} \\left(a\\ket{\\H} + b\\ket{\\V}\\right)_1\\left(c\\ket{\\H} + d\\ket{\\V}\\right)_2 &= ac\\,\\HH + ad\\,\\HV\\\\ &\\quad + bc\\,\\VH + bd\\,\\VV \\end{aligned}",
    "independent_diagonals": "\\ket{\\diag}_1\\ket{\\diag}_2 = \\tfrac12\\left(\\HH + \\HV + \\VH + \\VV\\right)",
